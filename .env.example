# Copy this file to .env and replace the password. Do not commit the real .env.
DB_HOST=127.0.0.1
DB_NAME=referral_platform
DB_USER=referral_user
DB_PASSWORD=replace-with-your-referral-user-password
DB_CHARSET=utf8mb4
APP_BASE_URL=/
APP_URL=https://your-domain.example
# Select one provider. Both providers use the same SMTP variable names.
EMAIL_PROVIDER=mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=Refer Earn Bill Reward and Donate
